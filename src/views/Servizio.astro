---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Cartello from '../components/Cartello.astro';
import { serviziIn } from '../data/servizi-lingue';
import { impresa, waHref } from '../data/impresa';
import { linguaDi, percorso } from '../i18n/lingue';
import { t as testi, f as riempi } from '../i18n/testi';

interface Props { slug: string }
const l = linguaDi(Astro);
const T = testi(l);
const S = T.servizio;
const u = (p: string) => percorso(p, l);
const servizi = serviziIn(l);
const s = servizi.find((x) => x.slug === Astro.props.slug)!;
const idx = servizi.findIndex((x) => x.slug === s.slug);
const prev = servizi[idx - 1];
const next = servizi[idx + 1];
const waS = waHref(`${riempi(T.generale.waServizio, { s: s.nome })} ${T.generale.dalSito}`);
const site = Astro.site!;
const url = new URL(u(`/${s.slug}`), site).href;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.nome,
    serviceType: s.nome,
    description: s.description,
    url,
    provider: { '@id': new URL('/#impresa', site).href },
    areaServed: impresa.zone.map((z) => ({ '@type': 'City', name: z })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: T.nonTrovata.home, item: new URL(u('/'), site).href },
      { '@type': 'ListItem', position: 2, name: s.nome, item: url },
    ],
  },
];
const strato = s.num === '=' ? S.tutti : riempi(S.strato, { n: s.num });
---
<Base title={s.title} description={s.description} jsonld={jsonld}>
  <section class="hero gridbg">
    <div class="wrap">
      <nav class="crumbs mono" aria-label={S.percorso}><a href={u('/')}>{T.nonTrovata.home}</a> / <a href={u('/#servizi')}>{T.menu.servizi}</a> / <span aria-current="page">{s.nome}</span></nav>
      <div class="hero-grid">
        <div class="stack">
          <p class="mono">{strato}</p>
          <h1>{s.h1}</h1>
          <p class="lead">{s.intro}</p>
          <div class="ctas">
            <a class="btn btn-p" href="#preventivo">{S.cta}</a>
            <a class="btn btn-s" href={waS}>{S.foto}</a>
          </div>
          <p class="quota"><span>{s.spessore}</span></p>
        </div>
        <figure class="hero-img">
          <Picture src={s.foto} alt={s.fotoAlt} formats={['avif']} fallbackFormat="webp" widths={[480, 760, 960]} sizes="(min-width: 1000px) 46vw, 92vw" loading="eager" fetchpriority="high" />
          {s.fotoNota && <figcaption>{s.fotoNota}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap two">
      <div class="stack">
        <p class="mono">{S.problema}</p>
        <h2>{s.problema.titolo}</h2>
        <p class="read">{s.problema.testo}</p>
      </div>
      <div class="stack">
        <p class="mono">{S.riconosci}</p>
        <ul class="tick">{s.problema.segni.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec gridbg">
    <div class="wrap two">
      <div class="stack">
        <p class="mono">{S.soluzione}</p>
        <h2>{s.soluzione.titolo}</h2>
        <p class="read">{s.soluzione.testo}</p>
        {s.nota && <p class="todo nota">[{s.nota}]</p>}
      </div>
      <div class="box">
        <p class="mono">{S.cosaFacciamo}</p>
        <ul class="tick">{s.soluzione.include.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  {s.prova && (
    <section class="sec">
      <div class="wrap two">
        <div class="stack">
          <p class="mono">{S.consiglio}</p>
          <h2>{s.prova.titolo}</h2>
          <p class="read">{S.consiglioTesto}</p>
        </div>
        <ol class="prova">{s.prova.passi.map((p) => <li>{p}</li>)}</ol>
      </div>
    </section>
  )}

  <section class="sec gridbg">
    <div class="wrap">
      <div class="sec-head">
        <p class="mono">{S.come}</p>
        <h2>{S.passiTitolo}<b>{S.passiForte}</b>.</h2>
      </div>
      <ol class="passi">
        {s.passi.map((p, i) => (
          <li class="rv"><span class="n">0{i + 1}</span><h3>{p.t}</h3><p>{p.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="mono">{S.prove}</p>
        <h2>{S.proveTitolo}<b>{S.proveForte}</b>.</h2>
      </div>
      <div class="proofs">
        <Cartello titolo={s.nome} foto={s.foto} alt={s.fotoAlt} luogo={`<span class="todo">${T.cartello.daInserire}</span>`} lavori={s.soluzione.include.slice(0, 2).join(', ')} committente={T.cartello.esempio} />
      </div>
      <p><a class="more" href={u('/lavori')}>{S.tuttiLavori} <span class="freccia" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="sec gridbg">
    <div class="wrap">
      <div class="sec-head">
        <p class="mono">{S.faq}</p>
        <h2>{s.nome}: <b>{S.faqForte}</b>.</h2>
      </div>
      <Faq items={s.faq} />
    </div>
  </section>

  <section class="sec" id="preventivo">
    <div class="wrap two">
      <div class="stack">
        <p class="mono">{S.contatti}</p>
        <h2>{S.parliamo}<b>{S.parliamoForte}</b>.</h2>
        <p class="read">{S.parliamoTesto}</p>
        <div class="ctas"><a class="btn btn-p" href={waS}>{T.menu.whatsapp}</a></div>
      </div>
      <ContactForm servizio={s.slug} id="preventivo-form" />
    </div>
  </section>

  <nav class="sec others" aria-label={S.altriEtichetta}>
    <div class="wrap">
      <p class="mono">{S.altri}</p>
      <div class="pn">
        {prev ? <a href={u(`/${prev.slug}`)} class="pn-a"><span class="mono"><span class="freccia" aria-hidden="true">←</span> {prev.num}</span>{prev.nome}</a> : <span />}
        {next ? <a href={u(`/${next.slug}`)} class="pn-a end"><span class="mono">{next.num} <span class="freccia" aria-hidden="true">→</span></span>{next.nome}</a> : <span />}
      </div>
      <ul class="all">
        {servizi.filter((x) => x.slug !== s.slug).map((x) => <li><a href={u(`/${x.slug}`)}><span class="mono">{x.num}</span> {x.nome}</a></li>)}
      </ul>
    </div>
  </nav>
</Base>

<style>
  .hero { padding-block: 24px 72px; }
  @media (min-width: 900px) { .hero { padding-block: 32px 96px; } }
  .crumbs { margin-block-end: 24px; }
  .crumbs a { display: inline-flex; min-height: 44px; align-items: center; }
  .hero-grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .hero h1 { font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .num { color: var(--bronze); }
  .lead { font-size: 1.25rem; color: var(--fg-2); max-width: 50ch; }
  .hero-img { margin: 0; position: relative; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--line); max-height: 520px; }
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-img figcaption { position: absolute; inset-inline-start: 8px; inset-block-end: 8px; background: var(--paper); color: var(--ink); font: 500 1rem var(--f-m); padding: 4px 8px; }
  .two { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .two { grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; } }
  .box { background: var(--bg-2); border: 1px solid var(--line); padding: 28px; display: grid; gap: 16px; }
  .nota { justify-self: start; padding: 8px 12px; }
  .prova { list-style: none; padding: 0; counter-reset: p; display: grid; }
  .prova li { counter-increment: p; display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding-block: 20px; border-block-start: 1px solid var(--line); color: var(--fg-2); }
  .prova li::before { content: counter(p); font: 800 2.5rem/1 var(--f-d); color: var(--bronze); }
  .passi { list-style: none; padding: 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 760px) { .passi { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .passi { grid-template-columns: repeat(4, 1fr); } }
  .passi li { background: var(--bg); padding: 28px 24px; display: grid; gap: 12px; align-content: start; }
  .passi .n { font: 800 3rem/1 var(--f-d); color: var(--bronze); }
  .passi p { color: var(--fg-2); }
  .proofs { display: grid; gap: 24px; }
  @media (min-width: 1000px) { .proofs { grid-template-columns: 380px 1fr; align-items: start; } }
  .more { display: inline-flex; min-height: 44px; align-items: center; margin-block-start: 16px; color: var(--bronze); font-weight: 700; }
  .others { background: var(--bg-3); }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-block: 16px 32px; }
  .pn-a { display: grid; gap: 4px; padding: 20px; border: 1px solid var(--line); text-decoration: none; font: 800 1.4rem/1.1 var(--f-d); text-transform: uppercase; min-height: 44px; }
  .pn-a:hover { border-color: var(--bronze); }
  .pn-a.end { text-align: end; }
  .all { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .all a { display: inline-flex; gap: 8px; min-height: 44px; align-items: center; }
</style>
