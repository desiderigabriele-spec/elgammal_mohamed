---
import Base from '../layouts/Base.astro';
import { impresa } from '../data/impresa';
import { linguaDi } from '../i18n/lingue';
import { t as testi } from '../i18n/testi';
const l = linguaDi(Astro);
const T = testi(l);
const P = T.privacy;
const i = impresa.indirizzo;
const titolare = `${impresa.ragioneSociale}, ${i.via}, ${i.cap} ${i.citta} (${i.provincia}). ${T.piede.piva} ${impresa.piva ?? '[da ricevere]'}. ${T.menu.email} ${impresa.email ?? '[da ricevere]'}.`;
// i segnaposto [tra parentesi quadre] diventano etichette ben visibili
const conSegnaposto = (s: string) => s.replace(/\[([^\]]+)\]/g, '<span class="todo">[$1]</span>');
---
<Base title={P.title} description={P.description}>
  <article class="sec first">
    <div class="wrap legal">
      <p class="todo note">{T.legale.verifica}</p>
      <h1>{P.titolo}<b>{P.titoloForte}</b></h1>
      {P.sezioni.map((x) => (
        <>
          <h2>{x.h}</h2>
          <p set:html={conSegnaposto(x.p.replace('{titolare}', titolare))} />
        </>
      ))}
    </div>
  </article>
</Base>
<style>
  .first { border-block-start: 0; }
  .legal { max-width: 760px; display: grid; gap: 16px; }
  .legal h2 { font-size: 1.75rem; margin-block-start: 24px; }
  .legal p { color: var(--fg-2); max-width: 62ch; }
  .legal .note { justify-self: start; padding: 6px 10px; color: var(--todo-fg); }
</style>
