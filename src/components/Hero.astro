---
// Hero della home: chi siamo, cosa facciamo, dove, e come contattarci. Poi rimanda alla stanza che cambia.
import { Picture } from 'astro:assets';
import { waHref } from '../data/impresa';
import finita from '../assets/render/stanza-finita.png';
const punti = ['Sopralluogo e preventivo gratuiti', 'Milano, Sesto San Giovanni e hinterland', 'Case, condomini e uffici, anche per lavori piccoli'];
---
<section class="hero">
  <div class="wrap hg">
    <div class="ht">
      <p class="mono">Impresa edile · Sesto San Giovanni · dal 2005</p>
      <h1>Ristrutturiamo casa tua, <b>dall'inizio alla fine</b>.</h1>
      <p class="sub">Muri, impianti, intonaci, cartongesso, rasature e pittura: tutti i lavori li fa un'impresa sola, nell'ordine giusto. Tu hai un solo preventivo e una sola persona a cui chiedere.</p>
      <ul class="tick">{punti.map((p) => <li>{p}</li>)}</ul>
      <div class="ctas">
        <a class="btn btn-p" href="/contatti">Sopralluogo gratuito</a>
        <a class="btn btn-s" href={waHref()}>Scrivi su WhatsApp</a>
      </div>
    </div>
    <figure class="hv">
      <Picture src={finita} alt="Soggiorno ristrutturato: pareti bianche, parquet chiaro, controsoffitto con faretti" formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="(min-width: 960px) 54vw, 100vw" loading="eager" fetchpriority="high" />
      <figcaption>
        <a class="next" href="#cantiere">Guarda come ci arriviamo <span aria-hidden="true">↓</span></a>
        <span class="ill">Ricostruzione 3D illustrativa</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: 32px 48px; background: var(--bg); }
  .hg { display: grid; gap: 32px; align-items: center; }
  .ht { display: grid; gap: 16px; }
  h1 { font-size: clamp(2.25rem, 7vw, 3.75rem); line-height: 1.05; }
  h1 b { color: var(--bronze); }
  .sub { color: var(--fg-2); font-size: 1.125rem; max-width: 36em; }
  .tick { margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-block-start: 8px; }
  .hv { margin: 0; display: grid; gap: 8px; }
  .hv :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--line); }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 8px 16px; flex-wrap: wrap; }
  .next { color: var(--bronze); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; }
  .ill { color: var(--fg-2); font: 500 1rem var(--f-m); }
  @media (min-width: 960px) {
    .hero { padding-block: 56px 64px; }
    .hg { grid-template-columns: 5fr 6fr; gap: 48px; }
  }
</style>
