---
// Hero della home (versione A, chiara): chi siamo, cosa facciamo, dove, e come contattarci. Poi rimanda alla stanza che cambia.
import { Picture } from 'astro:assets';
import { waHref } from '../data/impresa';
import finita from '../assets/render/stanza-finita.png';
const punti = ['Case, condomini e uffici, anche per lavori piccoli'];
// micro-fiducia: chi vede un sito curato può pensare a un'impresa cara. Non lo è.
const fiducia = ['Prezzi onesti', 'Tempi rapidi'];
---
<section class="hero">
  <div class="wrap hg">
    <div class="ht">
      <p class="etichetta"><span class="lungo">Impresa edile · </span>Sesto San Giovanni · dal 2005</p>
      <h1>Ristrutturiamo casa tua, <b>dall'inizio alla fine</b>.</h1>
      <ul class="fid">{fiducia.map((f) => <li><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" /><path d="M5.5 10.5l3 3 6-6.5" /></svg>{f}</li>)}</ul>
      <figure class="hv">
        <div class="foto">
          <Picture src={finita} alt="Soggiorno ristrutturato: pareti color sabbia, divano, poltrona, tende di lino e parquet chiaro" formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="(min-width: 960px) 54vw, 100vw" loading="eager" fetchpriority="high" />
          <span class="badge"><i aria-hidden="true"></i>Sopralluogo e preventivo gratuiti</span>
          <span class="ill">Ricostruzione 3D</span>
        </div>
        <figcaption>
          <a class="next" href="#cantiere">Guarda come ci arriviamo <span aria-hidden="true">↓</span></a>
        </figcaption>
      </figure>
      <p class="sub">Muri, impianti, intonaci, cartongesso, rasature e pittura: tutti i lavori li fa un'impresa sola, nell'ordine giusto. Tu hai un solo preventivo e una sola persona a cui chiedere.</p>
      <div class="ctas" data-hero-cta>
        <a class="btn btn-scuro" href="/contatti">Sopralluogo gratuito</a>
        <a class="btn btn-linea" href={waHref()}>Scrivi su WhatsApp</a>
      </div>
      <ul class="tick">{punti.map((p) => <li>{p}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: 16px 48px; background: var(--bg); color: var(--ink); }
  .hg { display: grid; }
  .ht { display: grid; gap: 12px; grid-template-areas: 'chip' 'h1' 'fid' 'foto' 'sub' 'cta' 'tick'; }
  .fid { grid-area: fid; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .fid li { display: inline-flex; align-items: center; gap: 8px; font: 700 1.0625rem/1.3 var(--f-b); color: var(--ink); }
  .fid svg { width: 20px; height: 20px; flex: none; }
  .fid circle { fill: var(--bronze-fill); }
  .fid path { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .etichetta { grid-area: chip; justify-self: start; margin: 0; font: 500 1rem/1.3 var(--f-m); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); background: #fff; border-radius: 999px; padding: 8px 14px; }
  h1 { grid-area: h1; font-size: clamp(2.5rem, 9vw, 4.25rem); line-height: 1; color: var(--ink); }
  h1 b { color: var(--bronze-testo); }
  .hv { grid-area: foto; margin: 0; display: grid; gap: 4px; }
  .foto { position: relative; border-radius: 20px; overflow: hidden; }
  .foto :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .badge { position: absolute; inset-inline-start: 12px; inset-block-end: 12px; display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--ink); border-radius: 999px; padding: 8px 14px; font: 700 1rem/1.2 var(--f-b); box-shadow: 0 6px 20px -8px rgba(0, 0, 0, 0.35); }
  .badge i { width: 10px; height: 10px; border-radius: 50%; background: #2f7a4a; flex: none; }
  figcaption { display: flex; }
  .next { color: var(--bronze-testo); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; }
  .ill { position: absolute; inset-block-start: 10px; inset-inline-end: 10px; background: rgba(31, 35, 38, 0.78); color: #fff; border-radius: 6px; padding: 4px 8px; font: 500 1rem/1.2 var(--f-m); }
  .lungo { display: none; }
  .sub { grid-area: sub; color: var(--ink-2); font-size: 1.125rem; max-width: 36em; margin: 0; }
  .ctas { grid-area: cta; display: grid; grid-template-columns: 1fr; gap: 12px; }
  .btn-scuro { background: var(--ink); color: #fff; }
  .btn-scuro:hover { background: #000; }
  .btn-linea { border-color: var(--ink); color: var(--ink); background: transparent; }
  .btn-linea:hover { background: var(--ink); color: #fff; }
  .tick { grid-area: tick; margin: 0; }
  .tick li { color: var(--ink-2); }
  .tick li::before { background: var(--bronze-testo); border-radius: 50%; }
  @media (min-width: 560px) { .lungo { display: inline; } .ctas { grid-template-columns: auto auto; justify-content: start; } }
  @media (min-width: 960px) {
    .hero { padding-block: 56px 72px; }
    .foto :global(img) { aspect-ratio: 16 / 10; }
    .ht { grid-template-columns: 5fr 6fr; column-gap: 56px; row-gap: 20px; align-items: start;
      grid-template-areas: 'chip foto' 'h1 foto' 'fid foto' 'sub foto' 'cta foto' 'tick foto'; grid-template-rows: auto auto auto auto auto 1fr; }
    .hv { align-self: center; }
  }
</style>
