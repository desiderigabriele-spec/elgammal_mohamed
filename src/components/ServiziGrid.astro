---
// Servizi in fila orizzontale. Ogni scheda ha l'immagine della fase corrispondente nella stanza che cambia.
import { Picture } from 'astro:assets';
import { servizi } from '../data/servizi';
import Scorrevole from './Scorrevole.astro';
import facciata from '../assets/foto/facciata-condominio.webp';
// fotogramma della sequenza (public/sequenza) che mostra la fase di ogni servizio
const fotogramma: Record<string, number> = {
  'muratura': 35, 'intonaci-imbiancatura': 59, 'rasatura-pareti': 81, 'cartongesso': 71, 'impianti': 47, 'ristrutturazioni-chiavi-in-mano': 99,
};
const pad = (i: number) => String(i).padStart(3, '0');
---
<Scorrevole etichetta="Servizi" w="min(80%, 340px)">
  {servizi.map((s) => {
    const f = fotogramma[s.slug];
    return (
      <a class="card" href={`/${s.slug}`}>
        <div class="f">
          {f !== undefined
            ? <img src={`/sequenza/sm/f${pad(f)}.webp`} srcset={`/sequenza/sm/f${pad(f)}.webp 960w, /sequenza/hd/f${pad(f)}.webp 1280w`} sizes="340px" width="960" height="540" alt="" loading="lazy" decoding="async" />
            : <Picture src={facciata} alt="" formats={['avif']} fallbackFormat="webp" widths={[480, 680]} sizes="340px" loading="lazy" />}
          <span class="tag">{f !== undefined ? 'Ricostruzione 3D' : 'Foto di esempio'}</span>
        </div>
        <div class="b">
          <span class="n" aria-hidden="true">{s.num}</span>
          <h3>{s.nome}</h3>
          <p>{s.breve}</p>
          <span class="go">Scopri <span aria-hidden="true">→</span></span>
        </div>
      </a>
    );
  })}
</Scorrevole>
<style>
  .card { display: grid; grid-template-rows: auto 1fr; background: var(--bg-2); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; text-decoration: none; transition: border-color .2s; }
  .card:hover { border-color: var(--bronze); }
  .f { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #2a2724; }
  .f img, .f :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tag { position: absolute; inset-inline-end: 8px; inset-block-start: 8px; background: rgba(17,20,22,.75); color: #eceae6; font: 500 1rem/1.2 var(--f-m); padding: 2px 8px; border-radius: 4px; }
  .b { padding: 16px 20px 24px; display: grid; gap: 8px; align-content: start; }
  .n { font: 500 1rem/1 var(--f-m); color: var(--bronze); letter-spacing: .08em; }
  h3 { font-size: 1.75rem; }
  p { color: var(--fg-2); }
  .go { color: var(--bronze); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-block-start: 4px; }
</style>
