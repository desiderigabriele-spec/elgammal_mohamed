---
// Un lavoro presentato come il cartello di cantiere che si vede per strada.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { titolo: string; foto: ImageMetadata; alt: string; luogo: string; lavori: string; committente: string; esempio?: boolean; tipo?: string }
const { titolo, foto, alt, luogo, lavori, committente, esempio = true, tipo = '' } = Astro.props;
---
<article class="sign" data-tipo={tipo}>
  <p class="title">{titolo}</p>
  <div class="ph">
    <Picture src={foto} alt={alt} formats={['avif']} fallbackFormat="webp" widths={[480, 760, 960]} sizes="(min-width: 1000px) 380px, 92vw" loading="lazy" />
    {esempio && <span class="ex">Foto di esempio</span>}
  </div>
  <dl>
    <dt>Luogo</dt><dd set:html={luogo} />
    <dt>Lavori</dt><dd>{lavori}</dd>
    <dt>Committente</dt><dd>{committente}</dd>
  </dl>
</article>
<style>
  .sign { background: var(--paper); color: var(--ink); border: 4px solid var(--paper); display: grid; align-content: start; }
  .title { background: var(--ink); color: #fff; font: 800 1.3rem/1.1 var(--f-d); text-transform: uppercase; padding: 12px; }
  .ph { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #cfccc5; }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ex { position: absolute; inset-inline-start: 8px; inset-block-end: 8px; background: var(--paper); color: var(--ink); font: 500 1rem var(--f-m); padding: 4px 8px; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr; }
  dt, dd { margin: 0; padding: 10px 12px; border-block-start: 1px solid #b9b6af; }
  dt { font: 500 1rem/1.4 var(--f-m); text-transform: uppercase; color: var(--ink-2); border-inline-end: 1px solid #b9b6af; }
  dd :global(.todo) { font-size: 0.9em; }
</style>
