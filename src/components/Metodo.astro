---
// Come lavoriamo: quattro promesse, una parola grande ciascuna.
import { linguaDi } from '../i18n/lingue';
import { t as testi } from '../i18n/testi';
const promesse = testi(linguaDi(Astro)).metodo;
---
<ul class="prom">
  {promesse.map((p, i) => (
    <li>
      <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <strong>{p.t}</strong>
      <p>{p.d}</p>
    </li>
  ))}
</ul>
<style>
  .prom { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (min-width: 900px) { .prom { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
  li { background: var(--bg-2); border: 1px solid var(--line); border-radius: 16px; padding: 20px 16px; display: grid; gap: 8px; align-content: start; }
  .n { font: 500 1rem/1 var(--f-m); color: var(--fg-2); letter-spacing: .08em; }
  strong { font: 800 clamp(1.9rem, 7vw, 2.75rem)/1 var(--f-d); text-transform: uppercase; color: var(--bronze); overflow-wrap: anywhere; }
  p { color: var(--fg-2); margin: 0; }
  @media (min-width: 900px) { li { padding: 28px 24px; } }
</style>
