---
import { impresa } from '../data/impresa';
import { servizi } from '../data/servizi';
interface Props { servizio?: string; id?: string }
const { servizio = '', id = 'preventivo' } = Astro.props;
const conf = { endpoint: impresa.moduloEndpoint, wa: impresa.whatsapp };
---
<form class="form paper" id={id} data-form novalidate data-conf={JSON.stringify(conf)}>
  <p class="form-t">Richiedi il sopralluogo <strong>gratuito</strong></p>
  <label class="field" for={`${id}-nome`}>Nome
    <input id={`${id}-nome`} name="nome" autocomplete="name" required />
  </label>
  <label class="field" for={`${id}-contatto`}>Telefono o email
    <input id={`${id}-contatto`} name="contatto" autocomplete="tel" inputmode="tel" required />
  </label>
  <label class="field" for={`${id}-tipo`}>Che lavoro ti serve?
    <select id={`${id}-tipo`} name="tipo">
      <option value="">Scegli (facoltativo)</option>
      {servizi.map((s) => <option value={s.nome} selected={s.slug === servizio}>{s.nome}</option>)}
      <option value="Altro">Altro</option>
    </select>
  </label>
  <label class="field" for={`${id}-msg`}>Due righe sul lavoro <small>(facoltativo: dove, quanto è grande)</small>
    <textarea id={`${id}-msg`} name="messaggio" rows="3"></textarea>
  </label>
  <p class="err" data-err role="alert" hidden></p>
  <button class="btn btn-ink" type="submit">Invia la richiesta</button>
  <p class="small">Sopralluogo e preventivo gratuiti. Le foto puoi mandarle su WhatsApp. Usiamo i tuoi dati solo per risponderti: <a href="/privacy">privacy</a>.</p>
  <p class="ok" data-ok role="status" hidden></p>
</form>

<style>
  .form { display: grid; gap: 16px; padding: 24px; align-content: start; }
  @media (min-width: 600px) { .form { padding: 32px; } }
  .form-t { font: 800 1.75rem/1 var(--f-d); text-transform: uppercase; color: var(--ink); }
  .form-t strong { color: var(--ink); text-decoration: underline; text-decoration-color: var(--bronze-logo); text-decoration-thickness: 4px; text-underline-offset: 4px; }
  .btn-ink { background: var(--ink); color: #fff; min-height: 56px; }
  .btn-ink:hover { background: #000; }
  .small { font-size: 1rem; color: var(--ink-2); }
  .err { background: #f7dcd6; color: #6b1f12; padding: 10px 12px; font-weight: 600; }
  .ok { background: #dfeee0; color: #1d4a24; padding: 10px 12px; font-weight: 600; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((f) => {
    const err = f.querySelector<HTMLElement>('[data-err]')!;
    const ok = f.querySelector<HTMLElement>('[data-ok]')!;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const conf = JSON.parse(f.dataset.conf || '{}') as { endpoint: string | null; wa: string | null };
      err.hidden = true; ok.hidden = true;
      const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
      const mancano: string[] = [];
      if (!d.nome?.trim()) mancano.push('il nome');
      if (!d.contatto?.trim()) mancano.push('un telefono o una email');
      if (mancano.length) {
        err.textContent = `Manca ${mancano.join(' e ')}: ci serve per risponderti.`;
        err.hidden = false;
        (f.querySelector(!d.nome?.trim() ? '[name=nome]' : '[name=contatto]') as HTMLElement).focus();
        return;
      }
      const testo = `Richiesta sopralluogo (dal sito)\nNome: ${d.nome}\nContatto: ${d.contatto}\nLavoro: ${d.tipo || '-'}\nMessaggio: ${d.messaggio || '-'}\nPagina: ${location.pathname}`;
      if (conf.endpoint) {
        try {
          const r = await fetch(conf.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ ...d, _subject: 'Richiesta sopralluogo (dal sito)', pagina: location.pathname }) });
          if (!r.ok) throw new Error(String(r.status));
          ok.textContent = 'Richiesta inviata. Ti ricontattiamo al più presto.'; ok.hidden = false; f.reset();
        } catch {
          err.textContent = 'Non siamo riusciti a inviare la richiesta. Riprova, oppure scrivici su WhatsApp.'; err.hidden = false;
        }
        return;
      }
      if (conf.wa) {
        ok.textContent = 'Ti stiamo portando su WhatsApp con il messaggio già scritto: premi Invia.'; ok.hidden = false;
        location.href = `https://wa.me/${conf.wa}?text=${encodeURIComponent(testo)}`;
        return;
      }
      err.textContent = 'Il modulo non è ancora collegato: mancano numero WhatsApp o indirizzo di invio dell\'impresa.';
      err.hidden = false;
    });
  });
</script>
