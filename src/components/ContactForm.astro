---
import { impresa } from '../data/impresa';
import { serviziIn } from '../data/servizi-lingue';
import { linguaDi, percorso } from '../i18n/lingue';
import { t as testi } from '../i18n/testi';
interface Props { servizio?: string; id?: string }
const { servizio = '', id = 'preventivo' } = Astro.props;
const l = linguaDi(Astro);
const M = testi(l).modulo;
const servizi = serviziIn(l);
const conf = { endpoint: impresa.moduloEndpoint, wa: impresa.whatsapp, testi: M.js };
---
<form class="form paper" id={id} data-form novalidate data-conf={JSON.stringify(conf)}>
  <p class="form-t">{M.titolo} <strong>{M.titoloForte}</strong></p>
  <label class="field" for={`${id}-nome`}>{M.nome}
    <input id={`${id}-nome`} name="nome" autocomplete="name" required />
  </label>
  <label class="field" for={`${id}-contatto`}>{M.contatto}
    <input id={`${id}-contatto`} name="contatto" autocomplete="tel" inputmode="tel" required dir="auto" />
  </label>
  <label class="field" for={`${id}-tipo`}>{M.tipo}
    <select id={`${id}-tipo`} name="tipo">
      <option value="">{M.scegli}</option>
      {servizi.map((s) => <option value={s.nome} selected={s.slug === servizio}>{s.nome}</option>)}
      <option value={M.altro}>{M.altro}</option>
    </select>
  </label>
  <label class="field" for={`${id}-msg`}>{M.messaggio} <small>{M.messaggioNota}</small>
    <textarea id={`${id}-msg`} name="messaggio" rows="3" dir="auto"></textarea>
  </label>
  <p class="err" data-err role="alert" hidden></p>
  <button class="btn btn-ink" type="submit">{M.invia}</button>
  <p class="small">{M.piccolo} <a href={percorso('/privacy', l)}>{M.privacy}</a>.</p>
  <p class="ok" data-ok role="status" hidden></p>
</form>

<style>
  .form { display: grid; gap: 16px; padding: 24px; align-content: start; }
  @media (min-width: 600px) { .form { padding: 32px; } }
  .form-t { font: 800 1.75rem/1 var(--f-d); text-transform: uppercase; color: var(--ink); }
  .form-t strong { color: var(--ink); text-decoration: underline; text-decoration-color: var(--bronze-logo); text-decoration-thickness: 4px; text-underline-offset: 4px; }
  .btn-ink { background: var(--ink); color: #fff; min-height: 56px; }
  .btn-ink:hover { background: #000; }
  .small { font-size: 1rem; color: var(--ink-2); }
  .err { background: #f7dcd6; color: #6b1f12; padding: 10px 12px; font-weight: 600; }
  .ok { background: #dfeee0; color: #1d4a24; padding: 10px 12px; font-weight: 600; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((f) => {
    const err = f.querySelector<HTMLElement>('[data-err]')!;
    const ok = f.querySelector<HTMLElement>('[data-ok]')!;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const conf = JSON.parse(f.dataset.conf || '{}') as { endpoint: string | null; wa: string | null; testi: Record<string, string> };
      const T = conf.testi;
      err.hidden = true; ok.hidden = true;
      const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
      const mancano: string[] = [];
      if (!d.nome?.trim()) mancano.push(T.ilNome);
      if (!d.contatto?.trim()) mancano.push(T.ilContatto);
      if (mancano.length) {
        err.textContent = T.manca.replace('{x}', mancano.join(` ${T.e} `));
        err.hidden = false;
        (f.querySelector(!d.nome?.trim() ? '[name=nome]' : '[name=contatto]') as HTMLElement).focus();
        return;
      }
      const testo = `${T.intestazione}\n${T.campoNome}: ${d.nome}\n${T.campoContatto}: ${d.contatto}\n${T.campoLavoro}: ${d.tipo || '-'}\n${T.campoMessaggio}: ${d.messaggio || '-'}\n${T.campoPagina}: ${location.pathname}`;
      if (conf.endpoint) {
        try {
          const r = await fetch(conf.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ ...d, _subject: T.intestazione, pagina: location.pathname }) });
          if (!r.ok) throw new Error(String(r.status));
          ok.textContent = T.inviata; ok.hidden = false; f.reset();
        } catch {
          err.textContent = T.errore; err.hidden = false;
        }
        return;
      }
      if (conf.wa) {
        ok.textContent = T.versoWa; ok.hidden = false;
        location.href = `https://wa.me/${conf.wa}?text=${encodeURIComponent(testo)}`;
        return;
      }
      err.textContent = T.nonCollegato;
      err.hidden = false;
    });
  });
</script>
