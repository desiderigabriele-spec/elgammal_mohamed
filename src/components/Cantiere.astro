---
// Hero della home: la stanza che si trasforma mentre scorri (fotogrammi renderizzati in Blender).
// Fotogrammi in public/sequenza/hd (1280 px) e public/sequenza/sm (720 px), nome f000.webp, f001.webp...
// Se i fotogrammi mancano, la sezione mostra solo l'immagine fissa e i testi.
import fs from 'node:fs';
import path from 'node:path';

const dir = path.join(process.cwd(), 'public', 'sequenza', 'hd');
const n = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith('.webp')).length : 0;
const pad = (i: number) => String(i).padStart(3, '0');
import { linguaDi, percorso } from '../i18n/lingue';
import { t as testi, f as riempi } from '../i18n/testi';
const l = linguaDi(Astro);
const T = testi(l);
const C = T.cantiere;
// fasi: [primo fotogramma, ultimo fotogramma] della sequenza (100 fotogrammi); i testi vengono dalla lingua
const base = [
  { a: 0, b: 7, href: '/contatti' },
  { a: 8, b: 19, href: '/ristrutturazioni-chiavi-in-mano' },
  { a: 20, b: 35, href: '/muratura' },
  { a: 36, b: 47, href: '/impianti' },
  { a: 48, b: 59, href: '/intonaci-imbiancatura' },
  { a: 60, b: 71, href: '/cartongesso' },
  { a: 72, b: 81, href: '/rasatura-pareti' },
  { a: 82, b: 99, href: '/contatti', cta: true },
];
const fasi = base.map((x, i) => ({ ...x, ...C.fasi[i], href: percorso(x.href, l) }));
const primo = n ? `/sequenza/hd/f000.webp` : '';
const ultimo = n ? `/sequenza/hd/f${pad(n - 1)}.webp` : '';
---
{n === 0 && <script is:inline>document.documentElement.classList.add('no-seq');</script>}
<section class="cant" id="cantiere" data-n={n} data-fasi={JSON.stringify(fasi.map((f) => [f.a, f.b]))}>
  <div class="stick">
    <div class="frame">
      {n > 0 && (
        <picture>
          <source media="(max-width: 899px)" srcset="/sequenza/sm/f000.webp" />
          <img class="first" src={primo} alt={C.altPrima} width="1280" height="720" loading="lazy" decoding="async" />
        </picture>
      )}
      <canvas aria-hidden="true"></canvas>
      <div class="bar" aria-hidden="true">{fasi.map(() => <i></i>)}</div>
      <button type="button" class="play" data-play data-t1={C.guarda1} data-t2={C.guarda}><span class="play-i" aria-hidden="true"></span><span class="play-t">{C.guarda}</span></button>
      <button type="button" class="stop" data-stop><span aria-hidden="true">❚❚</span> {C.ferma}</button>
    </div>
    <a class="salta" href="#servizi" data-salta aria-label={C.saltaEtichetta}>{C.salta} <span aria-hidden="true">↓</span></a>
    <div class="txt">
      <div class="intro" data-intro>
        <p class="mono">{C.sopra}</p>
        <h2 class="ih">{C.titolo}<b>{C.titoloForte}</b></h2>
        <p class="d d-scorri">{C.testo}</p>
        <p class="d d-chiusa">{C.testoChiusa}</p>
        <button type="button" class="play-tx" data-play2><span class="tri" aria-hidden="true"></span><span class="play-tx-t">{C.guarda1}</span></button>
      </div>
      <ol class="fasi" aria-label={C.fasiEtichetta}>
        {fasi.map((f, i) => (
          <li class="fase" data-i={i}>
            <div class="fh">
              <p class="mono">{riempi(C.fase, { n: i + 1, t: fasi.length })}</p>
              <h3>{f.t}</h3>
            </div>
            <p class="d">{f.d}</p>
            {f.cta
              ? <a class="btn btn-p" href={f.href}>{f.link}</a>
              : <a class="go" href={f.href}>{f.link} <span class="freccia" aria-hidden="true">→</span></a>}
          </li>
        ))}
      </ol>
    </div>
    <p class="hint" aria-hidden="true"><span class="fr"><i></i><i></i><i></i></span>{C.scorri}</p>
  </div>
  {n > 0 && (
    <noscript><img src={ultimo} alt={C.altDopo} width="1280" height="720" /></noscript>
  )}
</section>

<style>
  /* base (senza JavaScript o con "riduci movimento"): immagine e fasi in elenco */
  .cant { position: relative; background: var(--bg); }
  .stick { position: relative; }
  .frame { position: relative; aspect-ratio: 16 / 9; width: 100%; background: #2a2724; overflow: hidden; }
  .frame img, .frame canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .frame canvas { opacity: 0; }
  .frame.live canvas { opacity: 1; }
  /* tasti: "Salta" durante lo scorrimento, Play e Ferma nella versione chiusa (solo con JavaScript) */
  .salta, .play, .stop, .d-chiusa, .play-tx { display: none; }
  .play-tx { justify-self: start; align-items: center; gap: 10px; min-height: 48px; padding-inline: 20px; margin-block-start: 8px; border: 0; border-radius: 999px; background: var(--ink); color: #fff; font: 700 1rem/1 var(--f-b); text-transform: uppercase; letter-spacing: .04em; cursor: pointer; }
  .play-tx:hover { background: #000; }
  .play-tx .tri { width: 0; height: 0; border-style: solid; border-width: 7px 0 7px 11px; border-color: transparent transparent transparent currentColor; }
  :global([dir='rtl']) .play-tx .tri { transform: scaleX(-1); }
  .salta { position: absolute; z-index: 5; inset-inline-end: var(--gutter-e); inset-block-start: 24px; align-items: center; gap: 6px; min-height: 44px; padding-inline: 16px; border-radius: 999px; background: rgba(17,20,22,.72); color: #fff; font: 700 1rem/1 var(--f-b); text-transform: uppercase; letter-spacing: .04em; text-decoration: none; backdrop-filter: blur(6px); }
  .salta:hover { background: rgba(17,20,22,.9); }
  .play { position: absolute; z-index: 4; inset-inline-start: 50%; inset-block-start: 50%; transform: translate(-50%, -50%); flex-direction: column; align-items: center; gap: 10px; border: 0; background: none; cursor: pointer; color: #fff; font: 700 1rem/1.2 var(--f-b); text-transform: uppercase; letter-spacing: .04em; text-shadow: 0 2px 10px rgba(0,0,0,.6); }
  :global([dir='rtl']) .play { transform: translate(50%, -50%); }
  .play-i { width: 72px; height: 72px; border-radius: 50%; background: rgba(255,255,255,.92); box-shadow: 0 10px 30px -8px rgba(0,0,0,.6); position: relative; transition: transform .2s var(--mech); }
  .play-i::after { content: ''; position: absolute; inset-block-start: 50%; inset-inline-start: 54%; transform: translate(-50%, -50%); border-style: solid; border-width: 13px 0 13px 21px; border-color: transparent transparent transparent var(--ink); }
  .play:hover .play-i { transform: scale(1.06); }
  .play-t { background: rgba(17,20,22,.78); border-radius: 999px; padding: 8px 14px; text-shadow: none; white-space: nowrap; }
  .stop { position: absolute; z-index: 5; inset-inline-end: var(--gutter-e); inset-block-start: 24px; align-items: center; gap: 8px; min-height: 44px; padding-inline: 16px; border: 0; border-radius: 999px; background: rgba(17,20,22,.72); color: #fff; font: 700 1rem/1 var(--f-b); text-transform: uppercase; cursor: pointer; }
  .bar { position: absolute; inset-inline: 0; inset-block-start: 0; z-index: 2; display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; padding: 6px 8px; background: rgba(17,20,22,.6); }
  .bar i { height: 4px; border-radius: 2px; background: rgba(236,234,230,.25); transition: background .3s; }
  .bar i.fatto { background: #7d705d; }
  .bar i.ora { background: var(--bronze-fill); }
  .fh { display: grid; gap: 8px; }
  .txt { padding: 24px var(--gutter-e) 48px var(--gutter-s); display: grid; gap: 32px; }
  .intro, .fase { display: grid; gap: 12px; }
  .intro .ih { font-size: clamp(2.1rem, 9vw, 3rem); }
  .intro .ih b { color: var(--bronze); }
  .intro .d { color: var(--fg-2); max-width: 40ch; }
  .fase .btn { justify-self: start; }
  .fasi { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  .fase h3 { font-size: clamp(2.2rem, 9vw, 3.4rem); }
  .fase .d { color: var(--fg-2); max-width: 40ch; }
  .go { color: var(--bronze); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; justify-self: start; }
  /* invito a scorrere: tre frecce che si accendono in cascata (sparisce con l'introduzione) */
  .hint { display: none; align-items: center; gap: 10px; color: var(--bronze); font: 500 1rem/1 var(--f-m); letter-spacing: .1em; text-transform: uppercase; margin-block-start: 8px; }
  .fr { display: grid; justify-items: center; gap: 0; }
  .fr i { width: 12px; height: 12px; border-inline-end: 2.5px solid currentColor; border-block-end: 2.5px solid currentColor; transform: rotate(45deg); margin-block-start: -4px; opacity: .2; animation: cascata 1.5s infinite; }
  .fr i:nth-child(2) { animation-delay: .2s; } .fr i:nth-child(3) { animation-delay: .4s; }
  @keyframes cascata { 30% { opacity: 1; } 60%, 100% { opacity: .2; } }

  /* con JavaScript: la scena resta ferma e cambia mentre scorri */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.no-seq)) .cant { height: 900vh; }
    :global(.js:not(.no-seq)) .fh { position: relative; padding-block-end: 12px; }
    :global(.js:not(.no-seq)) .fh::after { content: ''; position: absolute; inset-inline-start: 0; inset-block-end: 0; height: 4px; width: 0; background: var(--bronze); transition: width .7s var(--mech) .15s; }
    :global(.js:not(.no-seq)) .fase.on .fh::after { width: min(100%, 320px); }
    :global(.js:not(.no-seq)) .stick { position: sticky; inset-block-start: var(--header); height: calc(100svh - var(--header)); overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
    :global(.js:not(.no-seq)) .txt { position: relative; display: block; padding: 20px var(--gutter-e) 88px var(--gutter-s); min-height: 0; }
    :global(.js:not(.no-seq)) .intro, :global(.js:not(.no-seq)) .fase { position: absolute; inset-inline: var(--gutter-s) var(--gutter-e); inset-block-start: 20px; transition: opacity .35s var(--mech), transform .35s var(--mech); }
    :global(.js:not(.no-seq)) .frame { aspect-ratio: 4 / 3; }
    :global(.js:not(.no-seq)) .fasi { display: block; }
    :global(.js:not(.no-seq)) .fase { opacity: 0; transform: translateY(12px); pointer-events: none; }
    :global(.js:not(.no-seq)) .fase.on { opacity: 1; transform: none; pointer-events: auto; }
    :global(.js:not(.no-seq)) .intro.off { opacity: 0; transform: translateY(-12px); pointer-events: none; }
    /* resta visibile per tutta la stanza, in basso a sinistra (a destra ci sono i tasti WhatsApp ed email); sparisce all'ultima fase */
    :global(.js:not(.no-seq)) .hint { display: flex; position: absolute; z-index: 4; inset-inline-start: var(--gutter-s); inset-block-end: 28px; margin: 0; transition: opacity .3s; }
    :global(.js:not(.no-seq)) .cant.fine .hint { opacity: 0; }
    :global(.js:not(.no-seq)) .salta { display: inline-flex; }
    /* versione chiusa (solo durante la visita, dopo averla vista o saltata): alta uno schermo, con il tasto Play */
    :global(.js:not(.no-seq)) .cant.chiusa { height: auto; }
    :global(.js:not(.no-seq)) .cant.chiusa .stick { position: relative; inset-block-start: 0; }
    :global(.js:not(.no-seq)) .cant.chiusa .salta,
    :global(.js:not(.no-seq)) .cant.chiusa .hint,
    :global(.js:not(.no-seq)) .cant.chiusa .d-scorri { display: none; }
    :global(.js:not(.no-seq)) .cant.chiusa .d-chiusa { display: block; }
    :global(.js:not(.no-seq)) .cant.chiusa .play { display: inline-flex; }
    :global(.js:not(.no-seq)) .cant.suona .play { display: none; }
    :global(.js:not(.no-seq)) .cant.suona .stop { display: inline-flex; }
  }
  /* telefono: numero e titolo della fase stanno sull'immagine, come un sottotitolo; sotto solo la spiegazione */
  @media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
    :global(.js:not(.no-seq)) .frame::after { content: ''; position: absolute; inset-inline: 0; inset-block-end: 0; height: 55%; background: linear-gradient(180deg, rgba(17,20,22,0), rgba(17,20,22,.9)); pointer-events: none; }
    :global(.js:not(.no-seq)) .fh { position: absolute; inset-inline: 0; inset-block-end: calc(100% + 20px + 16px); z-index: 3; --fg: #eceae6; --fg-2: #c9cdd0; --bronze: #b7a58c; color: var(--fg); }
    :global(.js:not(.no-seq)) .fase h3 { font-size: clamp(2.2rem, 10vw, 3rem); }
    :global(.js:not(.no-seq)) .fase .mono { color: var(--bronze); }
    /* versione chiusa su telefono: alta quanto serve, senza spazio vuoto sotto il testo */
    :global(.js:not(.no-seq)) .cant.chiusa .stick { height: auto; }
    :global(.js:not(.no-seq)) .cant.chiusa .txt { display: grid; padding-block: 20px 40px; }
    :global(.js:not(.no-seq)) .cant.chiusa .play { inset-block-start: 38%; }
    :global(.js:not(.no-seq)) .cant.chiusa .fh { inset-inline: var(--gutter-s) var(--gutter-e); inset-block-end: calc(100% + 16px); }
    :global(.js:not(.no-seq)) .cant.chiusa .intro, :global(.js:not(.no-seq)) .cant.chiusa .fasi { grid-area: 1 / 1; position: static; }
    :global(.js:not(.no-seq)) .cant.chiusa .fasi { display: grid; }
    :global(.js:not(.no-seq)) .cant.chiusa .fase { grid-area: 1 / 1; position: static; }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
    :global(.js:not(.no-seq)) .stick { display: block; }
    :global(.js:not(.no-seq)) .frame { position: absolute; inset: 0; aspect-ratio: auto; height: 100%; }
    :global(.js:not(.no-seq)) .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(17,20,22,.88) 0%, rgba(17,20,22,.6) 34%, rgba(17,20,22,0) 62%); pointer-events: none; }
    :global([dir='rtl'].js:not(.no-seq)) .frame::after { background: linear-gradient(270deg, rgba(17,20,22,.88) 0%, rgba(17,20,22,.6) 34%, rgba(17,20,22,0) 62%); }
    :global(.js:not(.no-seq)) .txt { position: absolute; inset-block: 0; inset-inline-start: 0; width: min(46%, 620px); padding: 0; --fg: #eceae6; --fg-2: #c9cdd0; --bronze: #b7a58c; color: var(--fg); }
    :global(.js:not(.no-seq)) .intro, :global(.js:not(.no-seq)) .fase { inset-block-start: auto; inset-block-end: 12vh; inset-inline: max(32px, calc((100vw - 1240px) / 2 + 16px)) 0; }
    :global(.js:not(.no-seq)) .intro .ih, :global(.js:not(.no-seq)) .fase h3 { font-size: clamp(3rem, 5vw, 4.6rem); }
    :global(.js:not(.no-seq)) .salta, :global(.js:not(.no-seq)) .stop { inset-block-start: 48px; inset-inline-end: max(32px, calc((100vw - 1240px) / 2 + 16px)); }
    :global(.js:not(.no-seq)) .play { inset-inline-start: 66%; }
    :global(.js:not(.no-seq)) .play-i { width: 88px; height: 88px; }
    :global(.js:not(.no-seq)) .bar { inset-inline: max(32px, calc((100vw - 1240px) / 2 + 16px)); inset-block-start: 20px; border-radius: 999px; }
    /* versione chiusa sul computer: testo a sinistra sul fondo chiaro, la stanza in un riquadro più piccolo a destra */
    :global(.js:not(.no-seq)) .cant.chiusa .stick { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; align-items: center; height: auto; overflow: visible; max-width: 1272px; margin-inline: auto; padding-block: 88px; padding-inline: max(32px, var(--gutter-s)) max(32px, var(--gutter-e)); }
    :global(.js:not(.no-seq)) .cant.chiusa .frame { position: relative; inset: auto; order: 2; height: auto; aspect-ratio: 16 / 10; border-radius: 20px; box-shadow: 0 24px 48px -26px rgba(0,0,0,.55); }
    :global(.js:not(.no-seq)) .cant.chiusa .frame::after { display: none; }
    :global(.js:not(.no-seq)) .cant.chiusa .txt { position: relative; inset: auto; order: 1; width: auto; display: grid; --fg: #23272a; --fg-2: #4a5055; --bronze: #66563f; color: var(--fg); }
    :global(.js:not(.no-seq)) .cant.chiusa .intro, :global(.js:not(.no-seq)) .cant.chiusa .fasi { grid-area: 1 / 1; position: static; }
    :global(.js:not(.no-seq)) .cant.chiusa .fasi { display: grid; }
    :global(.js:not(.no-seq)) .cant.chiusa .fase { grid-area: 1 / 1; position: static; }
    :global(.js:not(.no-seq)) .cant.chiusa .intro .ih, :global(.js:not(.no-seq)) .cant.chiusa .fase h3 { font-size: clamp(2.6rem, 4vw, 3.6rem); }
    :global(.js:not(.no-seq)) .cant.chiusa .play-tx { display: inline-flex; }
    :global(.js:not(.no-seq)) .cant.chiusa .bar { inset-inline: 14px; inset-block-start: 12px; }
    :global(.js:not(.no-seq)) .cant.chiusa .play { inset-inline-start: 50%; }
    :global(.js:not(.no-seq)) .cant.chiusa .stop { inset-block-start: 28px; inset-inline-end: 16px; }
    :global(.js:not(.no-seq)) .cant.chiusa .play-t { display: none; }
    :global(.js:not(.no-seq)) .hint { inset-inline-start: max(32px, calc((100vw - 1240px) / 2 + 16px)); inset-block-end: 4vh; color: #b7a58c; }
  }
</style>

<script>
  const sec = document.getElementById('cantiere') as HTMLElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
  if (sec) {
    const n = Number(sec.dataset.n || 0);
    if (!n || reduce) document.documentElement.classList.add('no-seq');
    else {
      const fasi: [number, number][] = JSON.parse(sec.dataset.fasi || '[]');
      const frame = sec.querySelector('.frame') as HTMLElement;
      const canvas = sec.querySelector('canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const intro = sec.querySelector('[data-intro]') as HTMLElement;
      const items = [...sec.querySelectorAll<HTMLElement>('.fase')];
      const set = matchMedia('(min-width: 900px)').matches ? 'hd' : 'sm';
      const pad = (i: number) => String(i).padStart(3, '0');
      const imgs: (HTMLImageElement | null)[] = new Array(n).fill(null);
      let current = -1, want = 0, visible = true, ticking = false;
      const bars = [...sec.querySelectorAll<HTMLElement>('.bar i')];
      // scorrimento a tratti: introduzione, poi per ogni fase una pausa (stanza ferma, arriva il testo) e l'avanzamento
      const INTRO = 4, PAUSA = 6;
      type Tratto = { u0: number; u1: number; i: number; a: number; b: number; pausa: boolean };
      const tratti: Tratto[] = [{ u0: 0, u1: INTRO, i: -1, a: 0, b: 0, pausa: true }];
      let u = INTRO;
      fasi.forEach(([a, b], i) => { tratti.push({ u0: u, u1: u + PAUSA, i, a, b: a, pausa: true }); u += PAUSA; tratti.push({ u0: u, u1: u + (b - a), i, a, b, pausa: false }); u += b - a; });
      const U = u;

      const size = () => {
        const r = frame.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1);
        canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr); current = -1; draw();
      };
      const nearest = (i: number) => { for (let d = 0; d < n; d++) { if (imgs[i - d]?.complete) return i - d; if (imgs[i + d]?.complete) return i + d; } return -1; };
      function draw() {
        const k = nearest(want); if (k < 0 || k === current) return;
        const im = imgs[k]!; const cw = canvas.width, ch = canvas.height;
        const s = Math.max(cw / im.naturalWidth, ch / im.naturalHeight);
        const w = im.naturalWidth * s, h = im.naturalHeight * s;
        ctx.drawImage(im, (cw - w) / 2, (ch - h) / 2, w, h); current = k; frame.classList.add('live');
      }
      // a ogni apertura della pagina la stanza riparte con lo scorrimento; si chiude solo durante questa visita
      let chiusa = false, suona = false, vistaFine = false;
      const playBtn = sec.querySelector<HTMLButtonElement>('[data-play]')!;
      const playT = playBtn.querySelector<HTMLElement>('.play-t')!;
      const play2 = sec.querySelector<HTMLButtonElement>('[data-play2]');
      const etichettaPlay = () => {
        const t = (vistaFine ? playBtn.dataset.t2 : playBtn.dataset.t1) || '';
        playT.textContent = t; const t2 = play2?.querySelector('.play-tx-t'); if (t2) t2.textContent = t;
      };

      // mostra lo stato a un punto della timeline (stessa timeline per lo scorrimento e per il Play)
      function applica(uu: number) {
        const t = tratti.find((x) => uu < x.u1) || tratti[tratti.length - 1];
        want = Math.min(n - 1, t.pausa ? t.a : Math.round(t.a + (uu - t.u0)));
        const fi = t.i;
        intro.classList.toggle('off', fi >= 0);
        items.forEach((it, i) => it.classList.toggle('on', i === fi));
        bars.forEach((b, i) => { b.classList.toggle('fatto', i < fi); b.classList.toggle('ora', i === fi); });
        sec!.classList.toggle('fine', fi === fasi.length - 1);
        if (fi === fasi.length - 1) vistaFine = true;
        draw();
      }
      // versione chiusa a riposo: la stanza finita, il titolo e il tasto Play
      function riposo() {
        want = n - 1;
        intro.classList.remove('off');
        items.forEach((it) => it.classList.remove('on'));
        bars.forEach((b) => { b.classList.add('fatto'); b.classList.remove('ora'); });
        sec!.classList.remove('fine');
        draw();
      }
      function update() {
        ticking = false;
        if (chiusa) return;
        const r = sec!.getBoundingClientRect(); const total = r.height - innerHeight;
        const p = Math.min(1, Math.max(0, -r.top / total));
        applica(p * U);
      }
      // chiude la stanza mantenendo fermo quello che si vede sullo schermo
      function chiudi(poi?: () => void) {
        if (chiusa) return;
        const h0 = sec!.offsetHeight, sopra = sec!.getBoundingClientRect().bottom <= 0;
        chiusa = true; sec!.classList.add('chiusa'); etichettaPlay();
        if (sopra) window.scrollTo({ top: scrollY - (h0 - sec!.offsetHeight), behavior: 'instant' as ScrollBehavior });
        riposo(); size();
        poi?.();
      }
      // "Salta": chiude la stanza e porta ai servizi
      sec.querySelector('[data-salta]')?.addEventListener('click', (e) => {
        e.preventDefault();
        chiudi(() => document.getElementById('servizi')?.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' }));
      });
      // passata la fine della stanza (vista tutta), si chiude da sola: tornando su non va riscorsa
      addEventListener('scroll', () => { if (!chiusa && vistaFine && sec!.getBoundingClientRect().bottom <= 0) chiudi(); }, { passive: true });
      // Play: la trasformazione va da sola, come un breve video (circa 16 secondi)
      const VEL = U / 16;
      let uuPlay = 0, ultimo = 0;
      const ferma = (finita: boolean) => {
        suona = false; sec!.classList.remove('suona'); etichettaPlay();
        if (!finita) riposo();
      };
      const passo = (ts: number) => {
        if (!suona) return;
        if (!visible) { ferma(false); return; }
        uuPlay += ultimo ? ((ts - ultimo) / 1000) * VEL : 0; ultimo = ts;
        if (uuPlay >= U) { applica(U - 0.001); ferma(true); return; }
        applica(uuPlay); requestAnimationFrame(passo);
      };
      play2?.addEventListener('click', () => playBtn.click());
      playBtn.addEventListener('click', () => {
        limite = n; start(); load();
        suona = true; sec!.classList.add('suona'); uuPlay = INTRO; ultimo = 0;
        requestAnimationFrame(passo);
      });
      sec.querySelector('[data-stop]')?.addEventListener('click', () => ferma(false));
      const onScroll = () => { if (!ticking && visible) { ticking = true; requestAnimationFrame(update); } };
      // carica prima il primo fotogramma di ogni fase e l'ultimo (la stanza finita), poi uno ogni 8, poi tutti gli altri
      const inizi = new Set([...fasi.map(([a]) => a), n - 1]);
      const order = [...Array(n).keys()].sort((a, b) => Number(inizi.has(b)) - Number(inizi.has(a)) || (a % 8) - (b % 8) || a - b);
      // a tappe: quando la sezione è vicina solo il primo fotogramma di ogni fase (8 immagini);
      // tutti gli altri solo quando si scorre verso la stanza. Chi non ci arriva non scarica niente di più.
      let next = 0, inflight = 0, limite = inizi.size;
      const load = () => {
        while (inflight < 6 && next < Math.min(limite, order.length)) {
          const i = order[next++]; const im = new Image(); im.decoding = 'async';
          inflight++; im.onload = im.onerror = () => { inflight--; if (Math.abs(i - want) < 3) draw(); load(); };
          im.src = `/sequenza/${set}/f${pad(i)}.webp`; imgs[i] = im;
        }
      };
      let started = false;
      const start = () => { if (started) return; started = true; size(); load(); if (chiusa) riposo(); else update(); };
      const near = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { near.disconnect(); if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true }); } }, { rootMargin: '150% 0px' });
      near.observe(sec);
      // seconda tappa: quando chi visita ha davvero scorso verso la stanza (il suo inizio è nella metà alta dello schermo)
      const tutto = () => {
        if (chiusa || limite >= n || sec!.getBoundingClientRect().top > innerHeight * 0.6) return;
        limite = n; removeEventListener('scroll', tutto); start(); load();
      };
      addEventListener('scroll', tutto, { passive: true });
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', size);
      new IntersectionObserver((es) => es.forEach((e) => { visible = e.isIntersecting; if (visible) onScroll(); })).observe(sec);
    }
  }
</script>
