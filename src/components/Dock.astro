---
// Contatto rapido: due bottoni tondi in basso a destra, WhatsApp ed email (il telefono resta in Contatti, nel menu e in fondo).
import { waHref, mailHref } from '../data/impresa';
import { linguaDi } from '../i18n/lingue';
import { t as testi } from '../i18n/testi';
const T = testi(linguaDi(Astro));
const D = T.dock;
---
<nav class="dock" aria-label={D.etichetta}>
  <a class="em" href={mailHref(`${T.generale.oggettoMail} ${T.generale.dalSito}`)} data-track="email" aria-label={D.email}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></a>
  <a class="wa" href={waHref(`${T.generale.waBase} ${T.generale.dalSito}`)} data-track="whatsapp" aria-label={D.whatsapp}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.4-4A8 8 0 1 1 8 19z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9.5 9.5c0 2.5 2.5 5 5 5l1-1.5-1.8-.8-.7.7c-.9-.4-1.5-1-1.9-1.9l.7-.7-.8-1.8z" fill="currentColor"/></svg></a>
</nav>
<style>
  .dock { position: fixed; z-index: 45; inset-inline-end: max(16px, env(safe-area-inset-right, 0px)); inset-block-end: calc(16px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 12px; justify-items: center; }
  .dock a { display: grid; place-items: center; border-radius: 50%; text-decoration: none; box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.55); transition: transform .2s var(--mech); }
  .dock a:hover { transform: translateY(-2px); }
  .dock .wa { width: 60px; height: 60px; background: #1f8f4e; color: #fff; }
  .dock .wa svg { width: 30px; height: 30px; }
  .dock .em { width: 48px; height: 48px; background: #fff; color: var(--ink); border: 1px solid var(--line-chiara); }
  .dock .em svg { width: 22px; height: 22px; }
  /* finché si vedono i bottoni dell'hero, i tasti tondi restano nascosti (non coprono niente) */
  .dock { transition: opacity .25s, transform .25s var(--mech), visibility .25s; }
  .dock.via { opacity: 0; visibility: hidden; transform: translateY(16px); }
  .dock a:focus-visible { outline: 3px solid var(--bronze); outline-offset: 3px; }
</style>
<script>
  const dock = document.querySelector<HTMLElement>('.dock');
  const cta = document.querySelector('[data-hero-cta]');
  if (dock && cta) new IntersectionObserver(([e]) => dock.classList.toggle('via', e.isIntersecting)).observe(cta);
</script>
