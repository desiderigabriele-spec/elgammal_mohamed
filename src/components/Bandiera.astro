---
// Bandierina rotonda della lingua. Per l'arabo non c'è una bandiera unica (è la lingua di tanti Paesi):
// si usa un tondo verde con la lettera ع.
import type { Lingua } from '../i18n/lingue';
interface Props { l: Lingua; size?: number }
const { l, size = 24 } = Astro.props;
const id = `b-${l}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg class="band" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs><clipPath id={id}><circle cx="16" cy="16" r="16" /></clipPath></defs>
  <g clip-path={`url(#${id})`}>
    {l === 'it' && (<><rect width="11" height="32" fill="#009246" /><rect x="11" width="10" height="32" fill="#fff" /><rect x="21" width="11" height="32" fill="#CE2B37" /></>)}
    {l === 'fr' && (<><rect width="11" height="32" fill="#0055A4" /><rect x="11" width="10" height="32" fill="#fff" /><rect x="21" width="11" height="32" fill="#EF4135" /></>)}
    {l === 'de' && (<><rect width="32" height="11" fill="#000" /><rect y="11" width="32" height="10" fill="#DD0000" /><rect y="21" width="32" height="11" fill="#FFCE00" /></>)}
    {l === 'en' && (
      <>
        <rect width="32" height="32" fill="#012169" />
        <path d="M-4 -4 L36 36 M36 -4 L-4 36" stroke="#fff" stroke-width="7" />
        <path d="M-4 -4 L36 36 M36 -4 L-4 36" stroke="#C8102E" stroke-width="2.5" />
        <path d="M16 0 V32 M0 16 H32" stroke="#fff" stroke-width="10" />
        <path d="M16 0 V32 M0 16 H32" stroke="#C8102E" stroke-width="6" />
      </>
    )}
    {l === 'ar' && (<><rect width="32" height="32" fill="#007A3D" /><text x="16" y="22" text-anchor="middle" font-size="17" font-weight="700" fill="#fff" font-family="Tahoma, 'Noto Sans Arabic', 'Geeza Pro', sans-serif">ع</text></>)}
  </g>
  <circle cx="16" cy="16" r="15.5" fill="none" stroke="rgba(0,0,0,.15)" />
</svg>
<style>
  .band { display: block; flex: none; border-radius: 50%; }
</style>
