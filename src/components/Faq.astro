---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { border-block-start: 1px solid var(--line); max-width: 860px; }
  details { border-block-end: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 16px; align-items: center; min-height: 64px; padding-block: 16px; cursor: pointer; font: 700 1.2rem/1.3 var(--f-b); }
  summary::-webkit-details-marker { display: none; }
  .plus { flex: none; width: 20px; height: 20px; position: relative; }
  .plus::before, .plus::after { content: ''; position: absolute; inset-inline-start: 0; inset-block-start: 9px; width: 20px; height: 2px; background: var(--bronze); transition: transform 0.3s var(--mech); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0); }
  details p { padding-block-end: 20px; color: var(--fg-2); max-width: 65ch; }
</style>
