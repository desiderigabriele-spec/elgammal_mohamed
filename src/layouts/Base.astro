---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { impresa } from '../data/impresa';
import { servizi } from '../data/servizi';
import { lingue, type Lingua } from '../i18n/lingue';
import fTitoli600 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import fTitoli800 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import fTesto400 from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lingua?: Lingua;
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, lingua = 'it', jsonld = [], noindex = false, ogImage = '/og-image.jpg' } = Astro.props;
const L = lingue[lingua];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site).href;
const i = impresa.indirizzo;

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['GeneralContractor', 'LocalBusiness'],
  '@id': new URL('/#impresa', site).href,
  name: 'El Gammal · Impresa edile',
  legalName: impresa.ragioneSociale,
  url: site.href,
  logo: new URL('/icons/icon-512.png', site).href,
  image: new URL('/og-image.jpg', site).href,
  foundingDate: String(impresa.dal),
  address: {
    '@type': 'PostalAddress',
    streetAddress: i.via,
    postalCode: i.cap,
    addressLocality: i.citta,
    addressRegion: i.provincia,
    addressCountry: i.paese,
  },
  geo: { '@type': 'GeoCoordinates', latitude: impresa.geo.lat, longitude: impresa.geo.lng },
  areaServed: [...impresa.zone.map((z) => ({ '@type': 'City', name: z })), { '@type': 'Country', name: 'Italia' }, { '@type': 'Country', name: 'Germania' }, { '@type': 'Country', name: 'Francia' }],
  knowsAbout: servizi.map((s) => s.nome),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servizi',
    itemListElement: servizi.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.nome, url: new URL(`/${s.slug}`, site).href } })),
  },
};
if (impresa.telefono) business.telephone = impresa.telefono;
if (impresa.email) business.email = impresa.email;
if (impresa.piva) business.vatID = impresa.piva;
if (impresa.googleBusiness) business.sameAs = [impresa.googleBusiness];
const blocks = [business, ...jsonld];
---
<!doctype html>
<html lang={lingua} dir={L.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="preload" href={fTitoli600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fTitoli800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fTesto400} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1F2326" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={L.locale.replace('-', '_')} />
    <meta property="og:site_name" content="El Gammal · Impresa edile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <Dock />
    <CookieBanner />
    <script>
      // comparsa a scatto degli elementi .rv (rispetta "riduci movimento" via CSS)
      const els = document.querySelectorAll('.rv');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
