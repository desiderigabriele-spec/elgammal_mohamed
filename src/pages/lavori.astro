---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PrimaDopo from '../components/PrimaDopo.astro';
import prima from '../assets/foto/cantiere-prima.webp';
import dopo from '../assets/foto/stanza-porte.webp';
import f1 from '../assets/foto/soggiorno-rasato.webp';
import f2 from '../assets/foto/facciata-condominio.webp';
import f3 from '../assets/foto/interno-controsoffitto.webp';
import f4 from '../assets/foto/muro-mattoni.webp';
import f5 from '../assets/foto/intonaco-esterno.webp';
import f6 from '../assets/foto/balconi-condominio.webp';
import f7 from '../assets/foto/ufficio-bianco.webp';
import f8 from '../assets/foto/soggiorno-bianco.webp';
import f9 from '../assets/foto/bagno-moderno.webp';

// Quando arrivano le foto vere: sostituire qui foto, didascalia e tipo, e togliere "esempio".
const lavori = [
  { foto: f1, t: 'rasatura', d: 'Rasatura soggiorno', alt: 'Soggiorno con pareti lisce' },
  { foto: f2, t: 'facciate', d: 'Facciata condominio', alt: 'Facciata di condominio' },
  { foto: f3, t: 'cartongesso', d: 'Controsoffitto in ufficio', alt: 'Ufficio con controsoffitto' },
  { foto: f4, t: 'muratura', d: 'Parete in mattoni', alt: 'Parete in mattoni' },
  { foto: f5, t: 'intonaci', d: 'Intonaco esterno', alt: 'Muro esterno intonacato' },
  { foto: f6, t: 'facciate', d: 'Facciata con balconi', alt: 'Facciata con balconi' },
  { foto: f7, t: 'cartongesso', d: 'Pareti per uffici', alt: 'Ufficio bianco' },
  { foto: f8, t: 'chiavi', d: 'Ristrutturazione appartamento', alt: 'Soggiorno ristrutturato' },
  { foto: f9, t: 'chiavi', d: 'Bagno rifatto', alt: 'Bagno moderno' },
];
const filtri = [
  ['tutti', 'Tutti'], ['muratura', 'Muratura'], ['intonaci', 'Intonaci'], ['rasatura', 'Rasatura'], ['cartongesso', 'Cartongesso'], ['facciate', 'Facciate'], ['chiavi', 'Chiavi in mano'],
];
---
<Base title="Lavori eseguiti: foto prima e dopo | El Gammal, impresa edile Sesto San Giovanni" description="Foto prima e dopo dei lavori di El Gammal: muratura, rasature, cartongesso, facciate e ristrutturazioni chiavi in mano a Sesto San Giovanni, Milano e all'estero." noindex={true}>
  <section class="sec gridbg first">
    <div class="wrap">
      <div class="sec-head">
        <p class="mono">Lavori</p>
        <h1>Prima e <b>dopo</b>.</h1>
        <p class="read">Ogni lavoro con il suo prima e dopo. Scegli il tipo di lavoro che ti interessa.</p>
        <p class="todo" style="justify-self:start;padding:6px 10px">[Pagina in attesa delle foto vere dei cantieri: ora ci sono foto di esempio]</p>
      </div>
      <PrimaDopo prima={prima} dopo={dopo} altPrima="Stanza prima dei lavori, con intonaco rovinato" altDopo="Stanza dopo i lavori, con pareti lisce e bianche" />
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="chips" role="group" aria-label="Filtra i lavori per tipo">
        {filtri.map(([k, v], i) => <button type="button" class="chip" data-f={k} aria-pressed={i === 0 ? 'true' : 'false'}>{v}</button>)}
      </div>
      <p class="vh" aria-live="polite" id="conteggio"></p>
      <ul class="grid" id="griglia">
        {lavori.map((l) => (
          <li data-t={l.t}>
            <figure>
              <Picture src={l.foto} alt={l.alt} formats={['avif']} fallbackFormat="webp" widths={[400, 700]} sizes="(min-width: 1000px) 380px, (min-width: 600px) 46vw, 92vw" loading="lazy" />
              <figcaption><span>{l.d}</span><span class="ex">esempio</span></figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="video">I video dei cantieri si aggiungeranno qui, nello stesso modo. <span class="todo">[video in arrivo dal cliente]</span></p>
    </div>
  </section>
</Base>
<style>
  .first { border-block-start: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-block-end: 32px; }
  .chip { min-height: 44px; padding-inline: 18px; border: 1px solid var(--fg-2); background: transparent; color: var(--fg); font: 600 1rem var(--f-b); cursor: pointer; }
  .chip[aria-pressed='true'] { background: var(--bronze-fill); border-color: var(--bronze-fill); color: var(--ink); }
  .grid { list-style: none; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  figure { margin: 0; background: var(--bg-2); border: 1px solid var(--line); }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption { display: flex; justify-content: space-between; gap: 8px; padding: 12px 14px; font-weight: 600; }
  .ex { font: 500 1rem var(--f-m); color: var(--fg-2); }
  .video { margin-block-start: 32px; color: var(--fg-2); }
</style>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('#griglia li');
  const out = document.getElementById('conteggio');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    let n = 0;
    items.forEach((i) => { const ok = c.dataset.f === 'tutti' || i.dataset.t === c.dataset.f; i.hidden = !ok; if (ok) n++; });
    if (out) out.textContent = `${n} lavori mostrati`;
  }));
</script>
