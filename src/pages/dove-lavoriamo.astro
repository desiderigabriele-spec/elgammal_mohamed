---
import Base from '../layouts/Base.astro';
import Mappa from '../components/Mappa.astro';
import { impresa } from '../data/impresa';
import { servizi } from '../data/servizi';
---
<Base title="Dove lavoriamo: Sesto San Giovanni, Milano e hinterland | El Gammal" description="Impresa edile con sede a Sesto San Giovanni: lavoriamo a Milano e nei comuni dell'hinterland nord, e abbiamo lavorato anche in Germania, Francia e Paesi arabi.">
  <section class="sec gridbg first">
    <div class="wrap two">
      <div class="stack">
        <p class="mono">Dove lavoriamo</p>
        <h1>Base a Sesto. <b>Cantieri anche all'estero.</b></h1>
        <p class="lead">La sede è in {impresa.indirizzo.via}, a Sesto San Giovanni. Da qui lavoriamo ogni giorno a Milano e nell'hinterland. Ci hanno chiamato anche in Germania, in Francia e nei Paesi arabi.</p>
        <div class="ctas"><a class="btn btn-p" href="/contatti">Sopralluogo gratuito</a></div>
      </div>
      <Mappa />
    </div>
  </section>

  <section class="sec">
    <div class="wrap two top">
      <div class="stack">
        <p class="mono">Milano e hinterland</p>
        <h2>Ogni giorno, <b>vicino a te</b>.</h2>
        <p class="read">Sopralluogo e preventivo gratuiti in tutta la zona. Alcuni dei comuni in cui lavoriamo:</p>
        <p class="todo" style="justify-self:start;padding:6px 10px">[Elenco comuni da confermare con il cliente]</p>
      </div>
      <ul class="places">
        {impresa.zone.map((z, i) => <li class:list={{ home: i === 0 }}><b>{z}</b><span>{i === 0 ? 'sede' : 'zona servita'}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec gridbg">
    <div class="wrap two top">
      <div class="stack">
        <p class="mono">All'estero</p>
        <h2>La stessa cura, <b>anche lontano</b>.</h2>
        <p class="read">Abbiamo eseguito lavori in Germania, in Francia e nei Paesi arabi. Se il tuo cantiere è fuori dall'Italia, scrivici: valutiamo ogni richiesta.</p>
        <p class="todo" style="justify-self:start;padding:6px 10px">[Città e lavori all'estero da inserire, con foto]</p>
      </div>
      <ul class="places">
        {impresa.estero.map((p) => <li><b>{p}</b><span>lavori eseguiti</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><p class="mono">Servizi in zona</p><h2>Cosa facciamo a <b>Sesto e Milano</b>.</h2></div>
      <ul class="svc">
        {servizi.map((s) => <li><a href={`/${s.slug}`}><span class="mono">{s.num}</span><span class="t">{s.nome}</span><span aria-hidden="true">→</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .first { border-block-start: 0; }
  .two { display: grid; gap: 40px; align-items: center; }
  .two.top { align-items: start; }
  @media (min-width: 1000px) { .two { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .lead { font-size: 1.25rem; color: var(--fg-2); max-width: 50ch; }
  .places { list-style: none; padding: 0; border-block-start: 1px solid var(--line); }
  .places li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; padding-block: 16px; border-block-end: 1px solid var(--line); }
  .places b { font: 800 clamp(1.6rem, 3.4vw, 2.4rem)/1 var(--f-d); text-transform: uppercase; }
  .places .home b { color: var(--bronze); }
  .places span { font: 500 1rem var(--f-m); color: var(--fg-2); }
  .svc { list-style: none; padding: 0; border-block-start: 1px solid var(--line); }
  .svc a { display: grid; grid-template-columns: 3ch 1fr auto; gap: 16px; align-items: center; min-height: 64px; border-block-end: 1px solid var(--line); text-decoration: none; }
  .svc .t { font: 800 1.5rem/1.1 var(--f-d); text-transform: uppercase; }
  .svc a:hover .t { color: var(--bronze); }
</style>
