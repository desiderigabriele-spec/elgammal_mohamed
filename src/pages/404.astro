---
import Base from '../layouts/Base.astro';
import { servizi } from '../data/servizi';
---
<Base title="Pagina non trovata | El Gammal" description="La pagina che cerchi non esiste." noindex={true}>
  <section class="sec gridbg first">
    <div class="wrap stack">
      <p class="quota"><span>404</span></p>
      <h1>Qui manca <b>un mattone</b>.</h1>
      <p class="read">La pagina che cerchi non c'è. Prova da qui:</p>
      <div class="ctas"><a class="btn btn-p" href="/">Home</a><a class="btn btn-s" href="/contatti">Contatti</a></div>
      <ul class="tick">{servizi.map((s) => <li><a href={`/${s.slug}`}>{s.nome}</a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .first { border-block-start: 0; min-height: 60vh; }
  .tick a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
